{
  "name": "vss",
  "private": true,
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "elysia": "^1.4.0",
      "@elysiajs/cors": "^1.4.0",
      "@elysia/eden": "^1.4.0",
      "zod": "^4.0.0",
      "typescript": "^5.6.0",
      "@supabase/supabase-js": "^2.119.2"
    }
  },
  "scripts": {
    "dev:web": "bun run --filter @vss/web dev",
    "dev:api": "bun run --filter @vss/api dev",
    "build:web": "bun run --filter @vss/web build",
    "build:api": "bun run --filter @vss/api build",
    "typecheck": "bun run --filter '*' typecheck",
    "format": "biome format",
    "format:w": "biome format --write",
    "lint": "biome lint",
    "lint:w": "biome lint --write",
    "check": "biome check",
    "check:w": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
