{
  "name": "repo",
  "private": true,
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "elysia": "^1.4.0",
      "@elysiajs/cors": "^1.4.0",
      "@elysiajs/eden": "^1.4.0",
      "zod": "^4.0.0",
      "typescript": "^5.6.0"
    }
  },
  "scripts": {
    "dev:web": "bun run --filter @repo/web dev",
    "dev:api": "bun run --filter @repo/api dev",
    "build:web": "bun run --filter @repo/web build",
    "build:api": "bun run --filter @repo/api build",

    "typecheck": "bun run --filter '*' typecheck",

    "format": "biome format",
    "format:w": "biome format --write",
    "lint": "biome lint",
    "lint:w": "biome lint --write",
    "check": "biome check",
    "check:w": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
