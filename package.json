{
  "name": "vss",
  "private": true,
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "elysia": "^1.4.0",
      "@elysiajs/cors": "^1.4.0",
      "@elysia/eden": "^1.4.0",
      "zod": "^4.0.0",
      "typescript": "^7.0.2",
      "@supabase/supabase-js": "^2.119.2"
    }
  },
  "scripts": {
    "start:web": "bun run --filter @vss/web start",
    "start:api": "bun run --filter @vss/api start",
    "dev:web": "bun --bun run --filter @vss/web dev",
    "dev:api": "bun --bun run --filter @vss/api dev",
    "build:web": "bun --bun run --filter @vss/web build",
    "typecheck": "bun --bun run --filter '*' typecheck",
    "format": "bunx --bun biome format",
    "format:w": "bunx --bun biome format --write",
    "lint": "bunx --bun biome lint",
    "lint:w": "bunx --bun biome lint --write",
    "check": "bunx --bun biome check",
    "check:w": "bunx --bun biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
