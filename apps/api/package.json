{
  "name": "@vss/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify --sourcemap=external",
    "typecheck": "bunx --bun tsc -p tsconfig.json"
  },
  "dependencies": {
    "@elysiajs/cors": "catalog:",
    "@supabase/middleware": "^1.0.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "catalog:",
    "@vss/shared": "workspace:*",
    "elysia": "catalog:",
    "supabase": "^3.2.0",
    "zod": "catalog:",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "catalog:"
  }
}
